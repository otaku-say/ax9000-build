# ============================================================
# AX9000 种子配置（seed config）
# 说明：作为 .config 基础壳，make defconfig 时自动补全依赖
# ============================================================

# ---- 目标平台：qualcommax / ipq807x（xiaomi_ax9000，OpenWrt expand layout）----
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax9000=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# ---- LuCI ----
CONFIG_PACKAGE_luci=y

# ---- dnsmasq-full（passwall 必需）----
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq=n

# ---- PassWall 全家桶（含可选协议核心）----
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# ---- AX9000 硬件控制（LED/风扇/温度，含中文界面）----
# 来源: https://github.com/nixevol/Ax9000WRTBuild (PolyForm Noncommercial 1.0.0)
CONFIG_PACKAGE_luci-app-ax900-hardware=y
CONFIG_PACKAGE_luci-i18n-ax900-hardware-zh-cn=y

# ---- 第三方插件（源码由 workflow "Integrate third-party plugins" 步骤拉取）----
CONFIG_PACKAGE_luci-app-wolultra=y
CONFIG_PACKAGE_luci-app-mini-diskmanager=y
CONFIG_PACKAGE_luci-app-natmapt=y
CONFIG_PACKAGE_stuntman-client=y
CONFIG_PACKAGE_luci-app-partexp=y

# ---- LuCI 语言：仅简体中文（不装其他语言；默认界面语言由 files/ uci-defaults 设为中文）----
CONFIG_LUCI_LANG_zh_Hans=y

# ---- 中国区官方优化（default-settings-chn：时区上海 / 国内 NTP / 镜像源替换）----
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

# ---- 构建加速 ----
CONFIG_CCACHE=y
