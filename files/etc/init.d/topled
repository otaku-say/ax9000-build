#!/bin/sh /etc/rc.common
# ============================================================
# AX9000 顶部大灯状态指示服务（procd 托管）
# ============================================================
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/topled-daemon
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	# 停止时清理顶部灯状态（避免残留 timer 闪烁）
	for led in "top:red" "top:green" "top:blue"; do
		[ -e "/sys/class/leds/$led" ] && {
			echo none > "/sys/class/leds/$led/trigger" 2>/dev/null
			echo 0 > "/sys/class/leds/$led/brightness" 2>/dev/null
		}
	done
}
