#!/bin/sh
# ============================================================
# AX9000 首次启动默认化脚本（uci-defaults）
# 功能：
#   1) LAN 地址 192.168.31.1
#   2) WiFi 全开 + 无密码 + SSID 区分（AX9000 / AX9000-5G / AX9000-5G-2）
#   3) 网页后台免密（root 空密码）
#   4) QCN9074 vendor board-2.bin 兜底
#   5) AX9000 硬件控制默认（顶部/前灯灯效与风扇，由 ax900-hardware 接管）
# ============================================================

# ---------- 1) LAN 地址 ----------
uci set network.lan.ipaddr='192.168.31.1'
uci commit network

# ---------- 2) WiFi ----------
# 2.1 补全无线默认配置（若缺失则生成）
wifi config >/dev/null 2>&1

# 2.2 启用全部 radio
for dev in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^=]*\)=wifi-device$/\1/p'); do
	uci set wireless.$dev.disabled='0'
done

# 2.3 无密码 + AX9000 系列 SSID（多频自动去重编号）
n2=0; n5=0; n6=0
for iface in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p'); do
	dev=$(uci -q get wireless.$iface.device)
	band=$(uci -q get wireless.$dev.band 2>/dev/null)
	case "$band" in
		2g) n2=$((n2+1)); ssid="AX9000"; [ $n2 -gt 1 ] && ssid="$ssid-$n2" ;;
		5g) n5=$((n5+1)); ssid="AX9000-5G"; [ $n5 -gt 1 ] && ssid="$ssid-$n5" ;;
		6g) n6=$((n6+1)); ssid="AX9000-6G"; [ $n6 -gt 1 ] && ssid="$ssid-$n6" ;;
		*)  ssid="AX9000" ;;
	esac
	uci set wireless.$iface.ssid="$ssid"
	uci set wireless.$iface.encryption='none'
	uci set wireless.$iface.disabled='0'
done
uci commit wireless

# ---------- 3) 网页后台免密（root 密码字段置空）----------
sed -i 's|^root:[^:]*:|root::|' /etc/shadow

# ---------- 4) vendor board-2.bin 兜底（防止被包管理覆盖）----------
[ -f /etc/board-2.bin ] && cp -f /etc/board-2.bin /lib/firmware/ath11k/QCN9074/hw1.0/board-2.bin

# ---------- 5) AX9000 硬件控制默认（LED / 风扇）----------
# 由 luci-app-ax900-hardware 接管（LuCI → AX9000 硬件）
# 顶部大灯：固定蓝色常亮（可改为温度联动 / 七色轮播 / 闪烁）
uci set ax900-hardware.main.top_mode='fixed'
uci set ax900-hardware.main.top_fixed_color='blue'
uci set ax900-hardware.main.top_blink='0'
# 前上灯：联网指示（在线绿 / 断网红）
uci set ax900-hardware.main.network_led_mode='connectivity'
uci set ax900-hardware.main.network_online_color='green'
uci set ax900-hardware.main.network_offline_color='red'
# 前下灯：保留系统标准灯语（default = 启动黄闪 → 就绪蓝常亮）
uci set ax900-hardware.main.system_led_mode='default'
# 温度联动改顶灯：默认关闭（风扇自动温控逻辑不受影响）；
# 如需"顶部按温度变色"（≤50°C 绿 / ≥50°C 蓝 / ≥60°C 黄 / ≥70°C 红），将各 fan_rule 的 led_control 改为 1
for r in $(uci show ax900-hardware 2>/dev/null | sed -n 's/^ax900-hardware\.\([^=]*\)=fan_rule$/\1/p'); do
	uci set ax900-hardware.$r.led_control='0'
done
uci commit ax900-hardware

# ---------- 6) 中国区默认设置（配合官方 default-settings-chn 包）----------
# 6.1 界面语言：默认简体中文
#     官方 default-settings 首次启动时会把语言重置为 auto，故先置 imm_init.lang 标记阻止
uci -q get system.@imm_init[0] >/dev/null 2>&1 || uci -q add system imm_init >/dev/null
uci set system.@imm_init[0].lang='1'
uci set luci.main.lang='zh_cn'
uci commit luci
# 6.2 软件源：南京大学镜像（snapshots 滚动路径，跟随官方主线更新，不锁定版本）
#     官方 default-settings-chn 脚本读取该值并替换 apk 源（https://downloads.immortalwrt.org -> 本值）
uci set system.@imm_init[0].apk_mirror='https://mirror.nju.edu.cn/immortalwrt'
uci commit system

exit 0
